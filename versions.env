# Pin every upstream dependency in one place. Bump a tag here, then rebuild.
# Sourced by scripts/build.sh and scripts/check-upstream.mjs

EMSDK_VERSION=6.0.12

LIBAVIF_VERSION=v1.4.2
LIBAVIF_URL=https://github.com/AOMediaCodec/libavif.git

DAV1D_VERSION=1.5.4
DAV1D_URL=https://github.com/videolan/dav1d.git

AOM_VERSION=v3.15.2
AOM_URL=https://aomedia.googlesource.com/aom
AOM_TARBALL_URL=https://storage.googleapis.com/aom-releases/libaom-3.15.2.tar.gz

# libyuv has no release tags; pin the commit libavif v1.4.2 vendors (version 1924).
LIBYUV_VERSION=644251f25
LIBYUV_URL=https://chromium.googlesource.com/libyuv/libyuv

# libsharpyuv ships inside libwebp. Pin the version libavif v1.4.2 vendors.
LIBWEBP_VERSION=v1.6.0
LIBWEBP_URL=https://github.com/webmproject/libwebp.git
