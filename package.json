{
  "name": "@phenomen/libavif-wasm",
  "version": "1.4.203",
  "description": "WebAssembly port of libavif with separate decode (dav1d) and encode (libaom) ES modules for browsers, Node 22+, and Edge/Workers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decode": {
      "types": "./dist/decode.d.ts",
      "default": "./dist/decode.js"
    },
    "./encode": {
      "types": "./dist/encode.d.ts",
      "default": "./dist/encode.js"
    },
    "./decode.wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/decode.wasm"
    },
    "./encode.wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/encode.wasm"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "README.md",
    "versions.env"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "build:docker": "./scripts/docker-build.sh",
    "test": "node --test test/node/*.test.mjs",
    "sizes": "./scripts/measure-sizes.sh",
    "check-upstream": "node scripts/check-upstream.mjs",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "node scripts/prepublish.mjs && npm test",
    "pack:check": "node scripts/verify-pack.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phenomen/libavif-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/phenomen/libavif-wasm/issues"
  },
  "homepage": "https://github.com/phenomen/libavif-wasm#readme",
  "keywords": [
    "avif",
    "libavif",
    "wasm",
    "webassembly",
    "dav1d",
    "libaom",
    "image",
    "decode",
    "encode"
  ]
}
